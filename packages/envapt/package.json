{
    "name": "envapt",
    "type": "module",
    "version": "9.1.1-next.0",
    "description": "Typed, validated config from process.env, .env files, or any object. One API on Node, Bun, Deno, Cloudflare Workers, and the browser.",
    "types": "./dist/types/index.d.mts",
    "exports": {
        ".": {
            "workerd": {
                "types": "./dist/types/index.portable.d.mts",
                "default": "./dist/portable/index.mjs"
            },
            "edge-light": {
                "types": "./dist/types/index.portable.d.mts",
                "default": "./dist/portable/index.mjs"
            },
            "fastly": {
                "types": "./dist/types/index.portable.d.mts",
                "default": "./dist/portable/index.mjs"
            },
            "worker": {
                "types": "./dist/types/index.portable.d.mts",
                "default": "./dist/portable/index.mjs"
            },
            "browser": {
                "types": "./dist/types/index.portable.d.mts",
                "default": "./dist/portable/index.mjs"
            },
            "react-native": {
                "types": "./dist/types/index.portable.d.mts",
                "default": "./dist/portable/index.mjs"
            },
            "deno": {
                "import": {
                    "types": "./dist/types/index.d.mts",
                    "default": "./dist/node/index.mjs"
                }
            },
            "node": {
                "import": {
                    "types": "./dist/types/index.d.mts",
                    "default": "./dist/node/index.mjs"
                }
            },
            "default": {
                "import": {
                    "types": "./dist/types/index.d.mts",
                    "default": "./dist/node/index.mjs"
                }
            }
        },
        "./config": {
            "import": {
                "types": "./dist/types/config.d.mts",
                "default": "./dist/node/config.mjs"
            }
        },
        "./legacy": {
            "workerd": {
                "types": "./dist/types/legacy.d.mts",
                "default": "./dist/portable/legacy.mjs"
            },
            "edge-light": {
                "types": "./dist/types/legacy.d.mts",
                "default": "./dist/portable/legacy.mjs"
            },
            "fastly": {
                "types": "./dist/types/legacy.d.mts",
                "default": "./dist/portable/legacy.mjs"
            },
            "worker": {
                "types": "./dist/types/legacy.d.mts",
                "default": "./dist/portable/legacy.mjs"
            },
            "browser": {
                "types": "./dist/types/legacy.d.mts",
                "default": "./dist/portable/legacy.mjs"
            },
            "react-native": {
                "types": "./dist/types/legacy.d.mts",
                "default": "./dist/portable/legacy.mjs"
            },
            "deno": {
                "import": {
                    "types": "./dist/types/legacy.d.mts",
                    "default": "./dist/node/legacy.mjs"
                }
            },
            "node": {
                "import": {
                    "types": "./dist/types/legacy.d.mts",
                    "default": "./dist/node/legacy.mjs"
                }
            },
            "default": {
                "import": {
                    "types": "./dist/types/legacy.d.mts",
                    "default": "./dist/node/legacy.mjs"
                }
            }
        },
        "./package.json": "./package.json"
    },
    "sideEffects": [
        "./dist/node/config.mjs",
        "./dist/node/index.mjs",
        "./dist/node/legacy.mjs",
        "**/bindNodeDefaults.*"
    ],
    "files": [
        "dist/**/*.mjs",
        "dist/**/*.map",
        "dist/types",
        "NOTICE.md",
        "LICENSE",
        "README.md",
        "CHANGELOG.md"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/materwelonDhruv/envapt.git"
    },
    "homepage": "https://envapt.materwelon.dev",
    "scripts": {
        "clean": "rm -rf dist",
        "build": "pnpm run clean && tsdown",
        "build:verify": "pnpm tsx scripts/verify-no-node.ts",
        "dev": "tsc --watch",
        "lint": "eslint '{src,tests,scripts}/**/*.{ts,tsx,mjs,cjs}' --cache",
        "lint:fix": "eslint '{src,tests,scripts}/**/*.{ts,tsx,mjs,cjs}' --fix --cache",
        "fmt": "prettier --write '{src,tests,scripts}/**/*.{ts,tsx,json,md}' --cache",
        "fmt:check": "prettier --check '{src,tests,scripts}/**/*.{ts,tsx,json,md}' --cache",
        "fmt:all": "prettier --write .",
        "tc": "tsc --noEmit",
        "test": "vitest run --config ../../vitest.config.ts",
        "test:watch": "vitest dev --config ../../vitest.config.ts",
        "test:integration": "node tests/integration/run.mjs",
        "test:workers": "tsc --noEmit -p tests/workers/tsconfig.json && vitest run --config vitest.workers.config.ts",
        "test:browser": "tsc --noEmit -p tests/browser/tsconfig.json && vitest run --config vitest.browser.config.ts",
        "test:consumer-build": "node tests/consumer-build/run.mjs",
        "test:tree-shaking": "node tests/tree-shaking/run.mjs",
        "test:exports-dedup": "node tests/exports-dedup/run.mjs",
        "test:resolution-matrix": "node tests/resolution-matrix/run.mjs",
        "test:tsc-emit": "node tests/tsc-emit/run.mjs",
        "test:tsc-emit:ts7": "ENVAPT_TSC_PACKAGE=typescript7 node tests/tsc-emit/run.mjs",
        "test:babel-emit": "node tests/babel-emit/run.mjs",
        "test:stage3-emit": "node tests/stage3-emit/run.mjs",
        "test:stage3-emit:ts7": "ENVAPT_TSC_PACKAGE=typescript7 node tests/stage3-emit/run.mjs",
        "test:consumer-types": "node tests/consumer-types/run.mjs",
        "test:consumer-types:ts7": "ENVAPT_TSC_PACKAGE=typescript7 node tests/consumer-types/run.mjs",
        "test:all": "node ../../scripts/test-all.mjs",
        "coverage": "pnpm run test --coverage",
        "cs": "changeset",
        "cs:publish": "changeset publish",
        "cs:status": "changeset status",
        "bump": "pnpm tsx ../../scripts/release/bump-jsr.ts",
        "release": "pnpm run cs:publish",
        "prepare": "husky",
        "prepublishOnly": "pnpm run clean && pnpm run build"
    },
    "keywords": [
        "env",
        ".env",
        "dotenv",
        "environment",
        "variables",
        "config",
        "configuration",
        "settings",
        "typescript",
        "type-safe",
        "deno",
        "bun",
        "cloudflare-workers",
        "workers",
        "browser",
        "zod",
        "valibot",
        "arktype",
        "validation",
        "decorator",
        "dotenv-alternative",
        "cross-runtime",
        "esm",
        "env-var"
    ],
    "author": "Dhruv <materwelondhruv@gmail.com>",
    "license": "Apache-2.0",
    "engines": {
        "node": ">=22.23.3",
        "bun": ">=1.3.11",
        "deno": ">=2.5.0"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "devDependencies": {
        "@cloudflare/vitest-plugin": "1.4.4",
        "@cloudflare/workers-types": "catalog:dev",
        "@vitest/browser-playwright": "5.0.5",
        "arktype": "^2.2.3",
        "esbuild": "^0.28.2",
        "jiti": "^2.7.0",
        "playwright": "1.64.1",
        "typescript7": "npm:typescript@7.0.2",
        "valibot": "^1.5.0",
        "webpack": "^5.112.0",
        "zod": "catalog:dev"
    }
}
