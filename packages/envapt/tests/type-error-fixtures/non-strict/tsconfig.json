{
    "$schema": "https://json.schemastore.org/tsconfig.json",
    "compilerOptions": {
        "target": "ES2024",
        "module": "esnext",
        "moduleResolution": "bundler",
        "lib": ["ESNext"],
        "esModuleInterop": true,
        "skipLibCheck": true,
        "strict": false,
        "noEmit": true,
        "isolatedModules": true,
        "types": ["node"]
    },
    "include": ["*.ts"]
}
