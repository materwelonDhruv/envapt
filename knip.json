{
    "$schema": "https://unpkg.com/knip@latest/schema.json",
    "workspaces": {
        ".": {
            "entry": ["scripts/**/*.ts"],
            "project": ["scripts/**/*.ts"],
            "ignoreBinaries": ["run.mjs"]
        },
        "packages/envapt": {
            "entry": [
                "scripts/*.ts",
                "tests/integration/modern-decorator-check.ts",
                "tests/*-emit/fixture.mts",
                "tests/*-emit/load.mjs"
            ],
            "vitest": {
                "config": ["../../vitest.config.ts", "vitest.browser.config.ts", "vitest.workers.config.ts"]
            },
            "ignore": ["tests/type-error-fixtures/**"],
            "ignoreDependencies": ["cloudflare"]
        },
        "apps/guide": {
            "entry": ["app/**/{page,layout,route,not-found}.{ts,tsx}", "mdx-components.tsx"],
            "project": ["app/**/*.{ts,tsx,css}", "components/**/*.{ts,tsx}", "lib/**/*.{ts,tsx}", "content/**/*.mdx"],
            "ignoreDependencies": ["envapt"]
        }
    }
}
