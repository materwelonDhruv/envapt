{
    "$schema": "https://unpkg.com/knip@latest/schema.json",
    "workspaces": {
        ".": {
            "entry": ["scripts/**/*.ts"],
            "project": ["scripts/**/*.ts"],
            "ignoreBinaries": ["run.mjs"],
            "ignoreDependencies": ["@typescript-eslint/parser"]
        },
        "packages/envapt": {
            "entry": [
                "scripts/*.ts",
                "tests/integration/modern-decorator-check.ts",
                "tests/integration/config-entry/print.mjs",
                "tests/tree-shaking/node-bind.entry.mjs",
                "tests/*-emit/fixture.mts",
                "tests/*-emit/load.mjs",
                "tests/consumer-types/fixtures/*.mts",
                "tests/*.types-test.ts"
            ],
            "vitest": {
                "config": ["../../vitest.config.ts", "vitest.browser.config.ts", "vitest.workers.config.ts"]
            },
            "ignore": ["tests/type-error-fixtures/**"],
            "ignoreDependencies": ["cloudflare"]
        },
        "apps/guide": {
            "entry": ["app/**/{page,layout,route,not-found}.{ts,tsx}", "mdx-components.tsx", "lib/typedoc-fumadocs.ts"],
            "project": ["app/**/*.{ts,tsx,css}", "components/**/*.{ts,tsx}", "lib/**/*.{ts,tsx}", "content/**/*.mdx"],
            "ignoreDependencies": ["typedoc-plugin-frontmatter"]
        }
    }
}
