{
    "name": "@envapt/guide",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "TWOSLASH=0 next dev",
        "dev:twoslash": "NODE_OPTIONS=--max-old-space-size=8192 next dev",
        "build": "fumadocs-mdx && NODE_OPTIONS=--max-old-space-size=8192 next build",
        "tc": "fumadocs-mdx && next typegen && tsc --noEmit",
        "start": "pnpm dlx serve out",
        "deploy": "wrangler deploy",
        "deploy:preview": "wrangler versions upload",
        "postinstall": "fumadocs-mdx",
        "lint": "eslint . --cache",
        "lint:fix": "eslint . --fix --cache",
        "test": "vitest run",
        "test:watch": "vitest dev",
        "fmt": "prettier --write . --cache",
        "fmt:check": "prettier --check . --cache"
    },
    "dependencies": {
        "clsx": "^2.1.1",
        "envapt": "workspace:^",
        "fumadocs-core": "16.15.9",
        "fumadocs-ui": "16.15.9",
        "next": "16.3.5",
        "next-themes": "^0.4.6",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "tailwind-merge": "^3.7.0"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "catalog:dev",
        "@seedcord/eslint-config": "catalog:dev",
        "@tailwindcss/postcss": "4.3.3",
        "@types/mdx": "^2.0.14",
        "@types/node": "catalog:dev",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "eslint": "^9.39.5",
        "eslint-config-next": "^16.3.5",
        "eslint-plugin-better-tailwindcss": "^4.7.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-mdx": "^3.8.1",
        "eslint-plugin-react-compiler": "19.1.0-rc.2",
        "eslint-plugin-tailwind-canonical-classes": "^1.4.1",
        "fumadocs-mdx": "15.4.0",
        "fumadocs-twoslash": "4.0.0",
        "postcss": "8.5.28",
        "prettier": "catalog:dev",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "shiki": "4.4.3",
        "tailwindcss": "4.3.3",
        "typescript": "catalog:dev",
        "vitest": "catalog:dev",
        "wrangler": "^4.131.1",
        "zod": "catalog:dev"
    }
}
